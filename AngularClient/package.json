{
  "name": "pharmacyms-angular-client",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --configuration development --host 127.0.0.1 --port 4200 --proxy-config proxy.conf.json",
    "build": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list"
  },
  "dependencies": {
    "@angular/common": "21.2.13",
    "@angular/compiler": "21.2.13",
    "@angular/core": "21.2.13",
    "@angular/forms": "21.2.13",
    "@angular/platform-browser": "21.2.13",
    "@angular/router": "21.2.13",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.13",
    "@angular/cli": "21.2.13",
    "@angular/compiler-cli": "21.2.13",
    "typescript": "~5.9.3",
    "@playwright/test": "^1.56.1"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "type": "module"
}
